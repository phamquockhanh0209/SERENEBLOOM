{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/api/chat$",
      "dest": "/api/chat.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1.html"
    },
    {
      "src": ".*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
